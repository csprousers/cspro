/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_SYNCER DIALOGEX 0, 0, 789, 314
STYLE DS_SETFONT | DS_FIXEDSYS | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
EXSTYLE WS_EX_APPWINDOW
CAPTION "CSPro Open Source Repository Syncer"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    PUSHBUTTON      "Sync Feature Branches",IDC_SYNC,526,22,112,14
    PUSHBUTTON      "Compare Against Open Source",IDC_COMPARE,526,62,112,14
    GROUPBOX        "Built Libraries",IDC_STATIC,657,7,125,76
    PUSHBUTTON      "Refresh Built Library Tags",IDC_REFRESH_LIBRARY_TAGS,664,22,112,14
    PUSHBUTTON      "Commit Built Library",IDC_COMMIT_LIBRARY,664,62,112,14
    GROUPBOX        "Manual Mirroring: Single Commit ",IDC_STATIC,7,91,259,96
    LTEXT           "Open source branch:",IDC_STATIC,17,109,68,8
    EDITTEXT        IDC_MANUAL_BRANCH_NAME,94,106,164,14,ES_AUTOHSCROLL
    LTEXT           "Commit (private):",IDC_STATIC,17,129,57,8
    EDITTEXT        IDC_MANUAL_SINGLE_COMMIT,94,126,164,14,ES_AUTOHSCROLL
    PUSHBUTTON      "Mirror Single Commit",IDC_MIRROR_SINGLE_COMMIT,146,145,112,14
    GROUPBOX        "Manual Mirroring: Merge Commit ",IDC_STATIC,277,91,302,96
    LTEXT           "Merge commit (private):",IDC_STATIC,291,109,78,8
    EDITTEXT        IDC_MANUAL_MERGE_COMMIT,406,106,164,14,ES_AUTOHSCROLL
    LTEXT           "Parent commit 1 (open source):",IDC_STATIC,291,129,102,8
    EDITTEXT        IDC_MANUAL_PARENT_COMMIT1,406,126,164,14,ES_AUTOHSCROLL
    LTEXT           "Parent commit 2 (open source):",IDC_STATIC,291,148,102,8
    EDITTEXT        IDC_MANUAL_PARENT_COMMIT2,406,145,164,14,ES_AUTOHSCROLL
    PUSHBUTTON      "Mirror Merge Commit",IDC_MIRROR_MERGE_COMMIT,458,165,112,14
    GROUPBOX        "Sync log:",IDC_STATIC,7,195,775,112
    LISTBOX         IDC_LOG,15,210,759,86,LBS_OWNERDRAWFIXED | LBS_NOINTEGRALHEIGHT | LBS_EXTENDEDSEL | LBS_NODATA | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP
    GROUPBOX        "CSPro Open Source Directories",IDC_STATIC,7,7,212,76
    LTEXT           "Code:",IDC_STATIC,17,24,20,8
    EDITTEXT        IDC_OPEN_SOURCE_CODE_DIRECTORY,67,22,144,14,ES_AUTOHSCROLL
    LTEXT           "Built libraries:",IDC_STATIC,17,45,44,8
    EDITTEXT        IDC_OPEN_SOURCE_LIBRARIES_DIRECTORY,67,42,144,14,ES_AUTOHSCROLL
    GROUPBOX        "Feature Branches",IDC_STATIC,229,7,417,76
    LTEXT           "Open source branch:",IDC_STATIC,239,25,68,8
    EDITTEXT        IDC_BRANCH_NAME,351,22,164,14,ES_AUTOHSCROLL
    LTEXT           "Oldest merge commit (private):",IDC_STATIC,239,45,100,8
    EDITTEXT        IDC_COMMIT_OLD,351,42,164,14,ES_AUTOHSCROLL
    LTEXT           "Newest merge commit (private):",IDC_STATIC,239,64,104,8
    EDITTEXT        IDC_COMMIT_NEW,351,61,164,14,ES_AUTOHSCROLL
END


