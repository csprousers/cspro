END

IDD_MANUAL_MIRRORER DIALOGEX 0, 0, 297, 291
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_CHILD | WS_CAPTION | WS_SYSMENU
CAPTION "Manual Mirrorer"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "Mirror Commits",IDC_STATIC,7,7,284,131
    LTEXT           "One or more commits can be mirrored from the private repository to the open source repository. Specify a branch name, which will be created if it does not exist, and specify one commit, or a range of commits, to mirror.",IDC_STATIC,15,20,266,29
    LTEXT           "Branch (open source):",IDC_STATIC,15,55,72,8
    EDITTEXT        IDC_BRANCH_NAME,121,52,164,14,ES_AUTOHSCROLL
    LTEXT           "Oldest commit (private):",IDC_STATIC,15,76,78,8
    EDITTEXT        IDC_COMMIT_OLDEST,121,73,164,14,ES_AUTOHSCROLL
    LTEXT           "Newest commit (private):",IDC_STATIC,15,97,82,8
    EDITTEXT        IDC_COMMIT_NEWEST,121,94,164,14,ES_AUTOHSCROLL
    PUSHBUTTON      "Mirror Commits",IDC_MIRROR_COMMIT,173,115,112,14
    GROUPBOX        "Mirror a Merge Commit ",IDC_STATIC,7,144,283,140
    LTEXT           "A merge commit can be mirrored by specifying the target and parents in the open source repository.",IDC_STATIC,15,158,266,22
    LTEXT           "Target branch (open source):",IDC_STATIC,15,187,96,8
    EDITTEXT        IDC_TARGET_BRANCH_NAME,121,184,164,14,ES_AUTOHSCROLL
    LTEXT           "Merge commit (private):",IDC_STATIC,15,207,78,8
    EDITTEXT        IDC_MERGE_COMMIT,121,204,164,14,ES_AUTOHSCROLL
    LTEXT           "Parent commit 1 (open source):",IDC_STATIC,15,227,102,8
    EDITTEXT        IDC_PARENT_COMMIT1,121,224,164,14,ES_AUTOHSCROLL
    LTEXT           "Parent commit 2 (open source):",IDC_STATIC,15,247,102,8
    EDITTEXT        IDC_PARENT_COMMIT2,121,244,164,14,ES_AUTOHSCROLL
    PUSHBUTTON      "Mirror Merge Commit",IDC_MIRROR_MERGE_COMMIT,173,264,112,14
END

