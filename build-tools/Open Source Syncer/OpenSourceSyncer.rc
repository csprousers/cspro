IDD_FEATURE_BRANCH_SYNCER DIALOGEX 0, 0, 305, 140
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_CHILD | WS_CAPTION | WS_SYSMENU
CAPTION "Feature Branch Syncer"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    PUSHBUTTON      "Find Unsynced Merge Commits",IDC_FIND_UNSYNCED_MERGE_COMMITS,30,112,112,14
    PUSHBUTTON      "Sync Feature Branches",IDC_SYNC_FEATURE_BRANCHES,163,112,112,14
    GROUPBOX        "Mirror Feature Branches",IDC_STATIC,7,7,291,126
    LTEXT           "One or more feature branches can be mirrored from the private repository to the open source repository.",IDC_STATIC,15,20,266,20
    LTEXT           "Target branch (open source):",IDC_STATIC,15,51,96,8
    EDITTEXT        IDC_TARGET_BRANCH_NAME,126,48,164,14,ES_AUTOHSCROLL
    LTEXT           "Oldest merge commit (private):",IDC_STATIC,15,71,100,8
    EDITTEXT        IDC_COMMIT_OLDEST,126,68,164,14,ES_AUTOHSCROLL
    LTEXT           "Newest merge commit (private):",IDC_STATIC,15,91,104,8
    EDITTEXT        IDC_COMMIT_NEWEST,126,88,164,14,ES_AUTOHSCROLL
END

IDD_SETTINGS DIALOGEX 0, 0, 311, 137
STYLE DS_SETFONT | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "Settings"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,94,116,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,166,116,50,14
