    EDITTEXT        IDC_GITHUB_PAT,121,83,177,14,ES_AUTOHSCROLL
END

IDD_MANAGE_LIBRARIES DIALOGEX 0, 0, 401, 276
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_CHILD | WS_CAPTION | WS_SYSMENU
CAPTION "Manage Libraries"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Manage CSPro's prebuilt external libraries and binary file dependencies:",IDC_STATIC,7,7,230,8
    GROUPBOX        "Library IDs",IDC_STATIC,7,24,388,151
    LTEXT           "Built libraries are identified by an ID based on a hash of the repository paths of included files as well as each file's MD5. The built libraries are associated with a local hash code (that does not necessarily use the MD5), and also by the actual hash.",IDC_STATIC,14,35,373,23
    CONTROL         "",IDC_LIBRARY_IDS,"SysListView32",LVS_REPORT | LVS_ALIGNLEFT | WS_BORDER | WS_TABSTOP,14,66,373,82
    PUSHBUTTON      "Refresh Library IDs",IDC_REFRESH_LIBRARY_IDS,139,154,122,14
    GROUPBOX        "Built Libraries",IDC_STATIC,7,182,387,87
    LTEXT           "To create a built library, specify a commit SHA, or leave it blank to use the HEAD.",IDC_STATIC,14,195,260,8
    LTEXT           "Commit:",IDC_STATIC,14,213,27,8
    EDITTEXT        IDC_COMMIT,51,210,164,14,ES_AUTOHSCROLL
    PUSHBUTTON      "Create and Commit Built Library",IDC_CREATE_BUILT_LIBRARY,232,210,122,14
    PUSHBUTTON      "Preview Built Library",IDC_PREVIEW_BUILT_LIBRARY,232,229,122,14
    PUSHBUTTON      "View List of Input Files",IDC_VIEW_BUILT_LIBRARY_INPUTS,232,248,122,14
END

IDD_LOG DIALOGEX 0, 0, 99, 22
STYLE DS_SETFONT | DS_FIXEDSYS | WS_CHILD | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "Operation Log"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
