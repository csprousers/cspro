    LTEXT           "The table shows data from GitHub: tags and any releases associated with the tag. You can create a new release, or view a release on GitHub.",IDC_STATIC,14,22,456,8
    CONTROL         "",IDC_RELEASES,"SysListView32",LVS_REPORT | LVS_ALIGNLEFT | WS_BORDER | WS_TABSTOP,14,38,611,194
    PUSHBUTTON      "Refresh Tags and Releases",IDC_REFRESH_RELEASES,113,243,122,14
    PUSHBUTTON      "View Release on GitHub",IDC_VIEW_RELEASE,259,243,122,14
    PUSHBUTTON      "Create Release From Tag",IDC_CREATE_RELEASE,405,243,122,14
END

