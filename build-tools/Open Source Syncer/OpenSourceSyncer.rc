    EDITTEXT        IDC_OPEN_SOURCE_CODE_DIRECTORY,74,22,224,14,ES_AUTOHSCROLL
    LTEXT           "Built libraries:",IDC_STATIC,17,45,44,8
    EDITTEXT        IDC_OPEN_SOURCE_LIBRARIES_DIRECTORY,74,42,224,14,ES_AUTOHSCROLL
    GROUPBOX        "GitHub Authorization",IDC_STATIC,7,70,297,37
