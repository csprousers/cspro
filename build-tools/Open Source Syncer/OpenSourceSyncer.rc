/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_MAINFRAME MENU
BEGIN
    POPUP "&File"
    BEGIN
        MENUITEM "&Close\tCtrl+W",              ID_FILE_CLOSE
        MENUITEM SEPARATOR
        MENUITEM "Settings",                    ID_SETTINGS
        MENUITEM SEPARATOR
        MENUITEM "E&xit\tAlt+F4",               ID_APP_EXIT
    END
    POPUP "&Commits"
    BEGIN
        MENUITEM "Sync &Feature Branches",      ID_SYNC_FEATURE_BRANCHES
        MENUITEM SEPARATOR
        MENUITEM "&Manually Mirror Commits",    ID_MANUALLY_MIRROR_COMMITS
    END
    POPUP "&Releases"
    BEGIN
        MENUITEM "Manage &Releases",            ID_MANAGE_RELEASES
        MENUITEM SEPARATOR
        MENUITEM "Sync &Tags",                  ID_SYNC_TAGS
    END
    POPUP "&Other"
    BEGIN
        MENUITEM "Manage &Libraries",           ID_MANAGE_LIBRARIES
        MENUITEM SEPARATOR
        MENUITEM "&Compare Repositories",       ID_COMPARE_REPOSITORIES
    END
    POPUP "&Window"
    BEGIN
        MENUITEM "&Cascade",                    ID_WINDOW_CASCADE
        MENUITEM "&Tile Top to Bottom",         ID_WINDOW_TILE_HORZ
        MENUITEM "Tile &Side by Side",          ID_WINDOW_TILE_VERT
    END
    POPUP "&Help"
    BEGIN
        MENUITEM "&About Open Source Syncer",   ID_APP_ABOUT
    END
END


