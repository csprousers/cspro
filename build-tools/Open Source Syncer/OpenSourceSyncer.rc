    PUSHBUTTON      "View History Log in Open Source",IDC_VIEW_OPEN_SOURCE_HISTORY_LOG,205,253,129,14
    PUSHBUTTON      "Create History Log From Private",IDC_CREATE_PRIVATE_HISTORY_LOG,367,253,129,14
