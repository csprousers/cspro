IDD_FILTERED_COMMITS_MESSAGE_CREATOR DIALOGEX 0, 0, 461, 116
STYLE DS_SETFONT | DS_FIXEDSYS | WS_CHILD | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "Filtered Commits Message Creator"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    GROUPBOX        "Create commit text for filtered commits:",IDC_STATIC,7,7,447,102
    LTEXT           "Repository directory with filtered commits:",IDC_STATIC,19,24,136,8
    EDITTEXT        IDC_FILTERED_REPO,174,21,209,14,ES_AUTOHSCROLL
    LTEXT           "Starting filtered commit:",IDC_STATIC,19,45,78,8
    EDITTEXT        IDC_FILTERED_COMMIT,174,42,209,14,ES_AUTOHSCROLL
    LTEXT           "Destination repository directory:",IDC_STATIC,19,66,105,8
    EDITTEXT        IDC_DESTINATION_REPO,174,63,209,14,ES_AUTOHSCROLL
    LTEXT           "Destination branch name with commits to link:",IDC_STATIC,19,87,146,8
    EDITTEXT        IDC_DESTINATION_BRANCH,174,84,209,14,ES_AUTOHSCROLL
    PUSHBUTTON      "&Run",IDC_CREATE_FILTERED_COMMIT_TEXT,397,21,50,14
END

IDD_CODE_PURIFIER DIALOGEX 0, 0, 621, 377
STYLE DS_SETFONT | DS_FIXEDSYS | WS_CHILD | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "Code Purifier"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    GROUPBOX        "Actions",IDC_STATIC,7,211,208,159
    PUSHBUTTON      "Apply EditorConfig Rules to Modified Files",IDC_APPLY_EDITORCONFIG_RULES,29,273,164,14
    CONTROL         "Use CSPro's EditorConfig when no others are present",IDC_USE_CSPRO_DEFAULT_EDITORCONFIG,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,18,292,187,10
    PUSHBUTTON      "Reset Branch to Clean Commit",IDC_RESET_BRANCH_TO_CLEAN_COMMIT,50,318,121,14
    CONTROL         "Create branch copy before reset",IDC_CREATE_BRANCH_COPY_BEFORE_RESET,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,51,338,121,10
    GROUPBOX        "Commits",IDC_STATIC,225,7,390,148
    CONTROL         "",IDC_COMMITS,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_ALIGNLEFT | WS_BORDER | WS_TABSTOP,233,19,375,128
    GROUPBOX        "Modified Files",IDC_STATIC,225,162,390,208
    CONTROL         "",IDC_MODIFIED_FILES,"SysListView32",LVS_REPORT | LVS_SINGLESEL | LVS_ALIGNLEFT | WS_BORDER | WS_TABSTOP,233,179,375,184
    GROUPBOX        "Repository",IDC_STATIC,7,7,208,94
    LTEXT           "Working directory:",IDC_STATIC,14,21,60,8
    CONTROL         "<a>...</a>",IDC_WORKING_DIRECTORY,"SysLink",WS_TABSTOP,80,21,123,8
    LTEXT           "Local branch:",IDC_STATIC,14,35,44,8
    LTEXT           "...",IDC_LOCAL_BRANCH,80,35,123,8
    LTEXT           "Remote branch:",IDC_STATIC,14,49,52,8
    LTEXT           "...",IDC_REMOTE_BRANCH,80,49,123,8
    LTEXT           "Clean commit:",IDC_STATIC,14,63,46,8
    LTEXT           "...",IDC_CLEAN_COMMIT,80,63,123,33
    GROUPBOX        "Branch Copies",IDC_STATIC,7,106,208,100
    LISTBOX         IDC_BRANCH_COPIES,14,120,194,57,LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON      "Create Copy",IDC_CREATE_BRANCH_COPY,38,182,62,14
    PUSHBUTTON      "Delete Copies",IDC_DELETE_BRANCH_COPIES,113,182,62,14
END

IDD_EDITORCONFIG_APPLIER DIALOGEX 0, 0, 487, 248
STYLE DS_SETFONT | DS_FIXEDSYS | WS_CHILD | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "EditorConfig Applier"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    PUSHBUTTON      "Apply EditorConfig Rules",IDC_APPLY_EDITORCONFIG_RULES,344,88,128,14
    GROUPBOX        "Options",IDC_STATIC,7,7,323,101
    LTEXT           "Directory root:",IDC_STATIC,19,24,48,8
    EDITTEXT        IDC_DIRECTORY,78,21,209,14,ES_AUTOHSCROLL
    PUSHBUTTON      "...",IDC_DIRECTORY_SELECT,296,21,25,14
    CONTROL         "Process all files",IDC_PROCESS_ALL_FILES,"Button",BS_AUTORADIOBUTTON | WS_GROUP,19,42,64,10
    CONTROL         "Process only files in the Git index (if applicable)",IDC_PROCESS_ONLY_FILES_IN_GIT_INDEX,
                    "Button",BS_AUTORADIOBUTTON,19,56,165,10
    CONTROL         "Process only files modified since the last Git remote commit (if applicable)",IDC_PROCESS_ONLY_MODIFIED_FILES_GIT,
                    "Button",BS_AUTORADIOBUTTON,19,70,247,10
    CONTROL         "Use CSPro's EditorConfig when no others are present",IDC_USE_CSPRO_DEFAULT_EDITORCONFIG,
                    "Button",BS_AUTOCHECKBOX | WS_TABSTOP,19,90,187,10
    LISTBOX         IDC_LOG,7,116,473,125,LBS_OWNERDRAWFIXED | LBS_NOINTEGRALHEIGHT | LBS_EXTENDEDSEL | LBS_NODATA | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP
    GROUPBOX        "Actions",IDC_STATIC,335,7,144,101
    PUSHBUTTON      "Create List of Applicable Rules",IDC_CREATE_LIST_OF_APPLICABLE_RULES,343,21,128,14
    PUSHBUTTON      "Create List of Git-Ignored Files",IDC_CREATE_LIST_OF_GIT_IGNORED_FILES,343,43,128,14
    PUSHBUTTON      "Cancel",IDCANCEL,344,65,128,14,NOT WS_VISIBLE
END

IDD_PROPERTIES DIALOGEX 0, 0, 309, 104
STYLE DS_SETFONT | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME
CAPTION "Properties"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    DEFPUSHBUTTON   "OK",IDOK,94,83,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,166,83,50,14
    GROUPBOX        "External Diff Tool",IDC_STATIC,7,7,295,68
    LTEXT           "Command:",IDC_STATIC,14,23,35,8
    EDITTEXT        IDC_DIFF_TOOL_COMMAND,57,20,203,14,ES_AUTOHSCROLL
