//
// Dialog
//

IDD_OAUTH_WAIT DIALOGEX 0, 0, 229, 67
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Waiting on OAuth 2.0 authorization..."
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    PUSHBUTTON      "Cancel",IDCANCEL,89,46,50,14
    LTEXT           "Contacting ... to perform OAuth 2.0 authorization. This process must occur in your web browser, so follow instructions that appear there.",IDC_OAUTH_WAIT_MESSAGE,7,7,215,34
END

IDD_LOGIN DIALOGEX 0, 0, 239, 97
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION
EXSTYLE WS_EX_TOPMOST
CAPTION "Enter Credentials"
FONT 8, "MS Shell Dlg", 400, 0, 0x1
BEGIN
    LTEXT           "Username:",IDC_STATIC,7,9,36,8
    EDITTEXT        IDC_USERNAME,52,7,180,14,ES_AUTOHSCROLL
    LTEXT           "Password:",IDC_STATIC,7,29,34,8
    EDITTEXT        IDC_PASSWORD,52,26,180,14,ES_PASSWORD | ES_AUTOHSCROLL
    LTEXT           "Invalid username/password. Try again.",IDC_STATIC_ERROR,7,48,225,23
    DEFPUSHBUTTON   "Login",IDOK,119,76,50,14
    PUSHBUTTON      "Cancel",IDCANCEL,182,76,50,14
END


