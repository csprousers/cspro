/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IDR_DEPRECATION_WARNINGS MENU
BEGIN
    POPUP "Deprecation &Warnings"
    BEGIN
        MENUITEM "&None",                       ID_CODE_DEPRECATION_WARNINGS_NONE
        MENUITEM "&Most",                       ID_CODE_DEPRECATION_WARNINGS_MOST
        MENUITEM "&All",                        ID_CODE_DEPRECATION_WARNINGS_ALL
    END
END

IDR_CODE_FOLDING MENU
BEGIN
    POPUP "Code Folding"
    BEGIN
        MENUITEM "Fold All\tAlt+0",             ID_CODE_FOLDING_FOLD_ALL
        MENUITEM "Unfold All\tAlt+Shift+0",     ID_CODE_FOLDING_UNFOLD_ALL
        MENUITEM "Toggle Current Level\tCtrl+Alt+F", ID_CODE_FOLDING_TOGGLE
        MENUITEM SEPARATOR
        POPUP "Level"
        BEGIN
            MENUITEM "None",                        ID_CODE_FOLDING_LEVEL_NONE
            MENUITEM "Procedures and Functions Only", ID_CODE_FOLDING_LEVEL_PROCS_FUNCS
            MENUITEM "All",                         ID_CODE_FOLDING_LEVEL_ALL
        END
    END
END

IDR_ADD_FILE MENU
BEGIN
    POPUP "0"
    BEGIN
        MENUITEM "Dictionary (External)",       ID_ADD_DICTIONARY_EXTERNAL
        MENUITEM "Dictionary (Working)",        ID_ADD_DICTIONARY_WORKING
        MENUITEM SEPARATOR
        MENUITEM "Form File",                   ID_ADD_FORM_FILE
        MENUITEM SEPARATOR
        MENUITEM "Code",                        ID_ADD_CODE
        MENUITEM SEPARATOR
        MENUITEM "Messages",                    ID_ADD_MESSAGES
        MENUITEM SEPARATOR
        MENUITEM "Report",                      ID_ADD_REPORT
        MENUITEM SEPARATOR
        MENUITEM "Resource (Directory)",        ID_ADD_RESOURCE_DIRECTORY
        MENUITEM "Resource (File)",             ID_ADD_RESOURCE_FILE
    END
END


